{
  "name": "contextmesh-backend",
  "version": "1.0.0",
  "description": "Backend server for ContextMesh MCP platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "express": "^4.18.2",
    "body-parser": "^1.20.1",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.6.5",
    "jayson": "^3.0.2",
    "pino": "^8.6.0",
    "snarkjs": "^0.7.9",
    "bs58": "^5.0.0",
    "@solana/web3.js": "^1.60.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.14",
    "@types/body-parser": "^1.19.2",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/mongoose": "^5.11.97",
    "@types/jayson": "^3.0.2",
    "@types/bs58": "^4.0.1",
    "@types/node": "^18.11.18",
    "typescript": "^4.9.4",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "@typescript-eslint/parser": "^5.44.0",
    "@typescript-eslint/eslint-plugin": "^5.44.0",
    "prettier": "^2.8.0",
    "jest": "^29.3.1",
    "ts-jest": "^29.0.3",
    "supertest": "^6.3.1",
    "@types/jest": "^29.2.3",
    "@types/supertest": "^2.0.12",
    "pino-pretty": "^9.2.0"
  },
  "license": "MIT"
}
