# .env.example

# HTTP server port
HTTP_PORT=3000

# MCP JSON-RPC port
MCP_PORT=4001

# MongoDB connection URI
DB_URI=mongodb://localhost:27017/contextmesh

# JWT settings
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h

# Solana RPC configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Marketplace on-chain registry contract
MARKETPLACE_CONTRACT_ADDRESS=

# Simulation stub namespace
SIMULATION_STUB_NAMESPACE=default
